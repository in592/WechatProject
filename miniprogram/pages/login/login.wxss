.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 40rpx 64rpx;
  background: #FFF8F6;
}

.hero {
  margin-bottom: 28rpx;
  padding: 48rpx 24rpx 40rpx;
  border-radius: 32rpx;
  background: #FFE4F1;
  text-align: center;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF7EC1, #65020A);
  box-shadow: 0 12rpx 32rpx rgba(101, 2, 10, 0.18);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 112rpx;
  text-align: center;
}

.title {
  color: #65020A;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #5A6069;
  font-size: 26rpx;
}

.card {
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 48rpx rgba(101, 2, 10, 0.06);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #5A6069;
  font-size: 26rpx;
}

.input {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFF8F6;
  color: #1F2329;
  font-size: 30rpx;
}

.error {
  margin: 4rpx 0 20rpx;
  color: #D9365F;
  font-size: 24rpx;
}

.submit {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.submit::after {
  border: none;
}

.tip {
  margin-top: 24rpx;
  color: #8A9099;
  font-size: 22rpx;
  text-align: center;
}
