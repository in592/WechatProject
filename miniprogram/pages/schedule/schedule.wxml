<view class="page">
  <view class="header">
    <view class="title">我的日程</view>
    <view class="subtitle">加一条课表，报名时自动帮你避开冲突</view>
  </view>

  <view class="form-card">
    <view class="form-head">
      <text class="form-title">添加日程</text>
      <button class="ocr-btn" bindtap="onOcrTap" loading="{{ocrLoading}}">拍照 / 选图</button>
    </view>

    <view class="field">
      <text class="label">日程名称</text>
      <input
        class="input"
        placeholder="例：高数补习"
        maxlength="30"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="field">
      <text class="label">地点（可选）</text>
      <input
        class="input"
        placeholder="例：教301"
        maxlength="40"
        value="{{location}}"
        bindinput="onLocationInput"
      />
    </view>

    <view class="field">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker">{{date}}</view>
      </picker>
    </view>

    <view class="time-row">
      <view class="field half">
        <text class="label">开始节次</text>
        <picker mode="selector" range="{{periodLabels}}" value="{{startPeriodIndex}}" bindchange="onStartPeriodChange">
          <view class="picker">{{periodLabels[startPeriodIndex]}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="label">结束节次</text>
        <picker mode="selector" range="{{periodLabels}}" value="{{endPeriodIndex}}" bindchange="onEndPeriodChange">
          <view class="picker">{{periodLabels[endPeriodIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="switch-row">
      <text class="switch-label">前一节是不同课程（课间 15 分钟）</text>
      <switch checked="{{changeBreak}}" color="#65020A" bindchange="onChangeBreakChange" />
    </view>

    <view class="time-row">
      <view class="field half">
        <text class="label">开始</text>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="picker">{{startTime}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="label">结束</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="picker">{{endTime}}</view>
        </picker>
      </view>
    </view>

    <view class="period-hint">第1节 08:10；每节 40 分钟；普通课间 10 分钟；第6节 14:00</view>

    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="add" bindtap="onAdd">添加日程</button>
  </view>

  <view class="list-head">
    <text>已添加</text>
    <text class="count">{{list.length}} 条</text>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">
    <view class="empty-title">还没有日程</view>
    <view class="empty-desc">先加一条「高数补习」，再去活动详情试报名</view>
  </view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="date-badge">
        <text class="date">{{item.dateText}}</text>
        <text class="week">{{item.weekdayText}}</text>
      </view>
      <view class="item-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-time">{{item.timeText}}<text wx:if="{{item.location}}"> · {{item.location}}</text></view>
      </view>
      <button class="delete" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>

  <view class="hint">添加后去活动详情点「报名」，冲突会被拦截并给出替代时段。</view>

  <view class="modal-mask" wx:if="{{ocrModalVisible}}" catchtap="onOcrModalClose">
    <scroll-view class="ocr-modal" scroll-y catchtap="noop">
      <view class="modal-head">
        <text class="modal-title">识别结果（{{ocrDrafts.length}} 门课）</text>
        <text class="modal-close" bindtap="onOcrModalClose">×</text>
      </view>
      <view class="modal-tip">确认每门课的第几节和时间，可修改或删除，最后一次性导入</view>

      <view class="week-row">
        <text class="modal-label">本周周一</text>
        <picker mode="date" value="{{weekStartDate}}" bindchange="onWeekStartChange">
          <view class="modal-picker week-picker">{{weekStartDate}}</view>
        </picker>
      </view>

      <view class="draft-card" wx:for="{{ocrDrafts}}" wx:key="id">
        <view class="draft-head">
          <text class="draft-index">课程 {{index + 1}}</text>
          <text class="draft-delete" data-index="{{index}}" bindtap="onDraftDelete">删除</text>
        </view>

        <input class="modal-input" value="{{item.title}}" data-index="{{index}}" bindinput="onDraftTitleInput" />
        <input class="modal-input draft-gap" value="{{item.location}}" data-index="{{index}}" bindinput="onDraftLocationInput" placeholder="地点（可选）" />

        <view class="modal-row">
          <view class="modal-half">
            <text class="modal-label">日期</text>
            <picker mode="date" value="{{item.date}}" data-index="{{index}}" bindchange="onDraftDateChange">
              <view class="modal-picker">{{item.date}}</view>
            </picker>
          </view>
          <view class="modal-half">
            <text class="modal-label">前一节不同课</text>
            <switch checked="{{item.changeBreak}}" color="#65020A" data-index="{{index}}" bindchange="onDraftChangeBreak" />
          </view>
        </view>

        <view class="modal-row">
          <view class="modal-half">
            <text class="modal-label">开始节次</text>
            <picker mode="selector" range="{{periodLabels}}" value="{{item.startPeriodIndex}}" data-index="{{index}}" bindchange="onDraftStartPeriodChange">
              <view class="modal-picker">{{periodLabels[item.startPeriodIndex]}}</view>
            </picker>
          </view>
          <view class="modal-half">
            <text class="modal-label">结束节次</text>
            <picker mode="selector" range="{{periodLabels}}" value="{{item.endPeriodIndex}}" data-index="{{index}}" bindchange="onDraftEndPeriodChange">
              <view class="modal-picker">{{periodLabels[item.endPeriodIndex]}}</view>
            </picker>
          </view>
        </view>

        <view class="draft-summary">
          {{periodLabels[item.startPeriodIndex]}} 至 {{periodLabels[item.endPeriodIndex]}} · {{item.startTime}} - {{item.endTime}}
        </view>
      </view>

      <view class="modal-error" wx:if="{{error}}">{{error}}</view>

      <button class="modal-add" bindtap="onImportDrafts">一键导入 {{ocrDrafts.length}} 门课</button>
    </scroll-view>
  </view>
</view>
