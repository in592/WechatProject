.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  background: #FFF8F6;
}

.header {
  padding: 8rpx 4rpx 0;
}

.title {
  color: #65020A;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 8rpx;
  color: #8A9099;
  font-size: 24rpx;
}

.form-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-title {
  color: #65020A;
  font-size: 30rpx;
  font-weight: 600;
}

.ocr-btn {
  width: auto;
  height: 60rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 30rpx;
  background: #FFE4F1;
  color: #65020A;
  font-size: 22rpx;
  line-height: 60rpx;
}

.ocr-btn::after {
  border: none;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #5A6069;
  font-size: 24rpx;
}

.input,
.picker {
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #FFF8F6;
  color: #1F2329;
  font-size: 28rpx;
  line-height: 80rpx;
}

.time-row {
  display: flex;
}

.half {
  flex: 1;
}

.half + .half {
  margin-left: 20rpx;
}

.error {
  margin: 0 0 16rpx;
  color: #D9365F;
  font-size: 24rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 20rpx;
}

.switch-label {
  flex: 1;
  padding-right: 16rpx;
  color: #5A6069;
  font-size: 24rpx;
  line-height: 1.5;
}

.period-hint {
  margin: -8rpx 0 20rpx;
  color: #8A9099;
  font-size: 22rpx;
  line-height: 1.5;
}

.ocr-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.ocr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocr-title {
  color: #65020A;
  font-size: 26rpx;
  font-weight: 600;
}

.ocr-clear {
  color: #D9365F;
  font-size: 22rpx;
}

.ocr-tip {
  margin-top: 8rpx;
  color: #8A9099;
  font-size: 22rpx;
  line-height: 1.5;
}

.ocr-line {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #FFF8F6;
  color: #1F2329;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.add {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 84rpx;
}

.add::after {
  border: none;
}

.list-head {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
  color: #5A6069;
  font-size: 24rpx;
}

.count {
  color: #8A9099;
}

.empty {
  margin-top: 8rpx;
  padding: 60rpx 32rpx;
  border-radius: 24rpx;
  background: #FFE4F1;
  text-align: center;
}

.empty-title {
  color: #65020A;
  font-size: 30rpx;
  font-weight: 500;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8A6A72;
  font-size: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.05);
}

.date-badge {
  flex: none;
  width: 96rpx;
  text-align: center;
}

.date {
  display: block;
  color: #65020A;
  font-size: 26rpx;
  font-weight: 600;
}

.week {
  display: block;
  margin-top: 4rpx;
  color: #8A9099;
  font-size: 20rpx;
}

.item-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.item-title {
  color: #1F2329;
  font-size: 28rpx;
  font-weight: 600;
}

.item-time {
  margin-top: 6rpx;
  color: #5A6069;
  font-size: 24rpx;
}

.delete {
  flex: none;
  width: auto;
  height: 60rpx;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #D9365F;
  font-size: 24rpx;
  line-height: 60rpx;
}

.delete::after {
  border: none;
}

.hint {
  margin-top: 28rpx;
  color: #8A9099;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(31, 35, 41, 0.45);
}

.ocr-modal {
  box-sizing: border-box;
  width: 100%;
  height: 86vh;
  padding: 28rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFF8F6;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  color: #65020A;
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  padding: 0 10rpx;
  color: #8A9099;
  font-size: 44rpx;
  line-height: 1;
}

.modal-tip {
  margin-top: 8rpx;
  color: #8A9099;
  font-size: 22rpx;
  line-height: 1.5;
}

.modal-lines {
  max-height: 220rpx;
  margin-top: 16rpx;
}

.modal-line {
  margin-bottom: 10rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #1F2329;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.modal-line.active {
  border-color: #65020A;
  background: #FFE4F1;
}

.modal-field {
  margin-top: 16rpx;
}

.modal-label {
  display: block;
  margin-bottom: 8rpx;
  color: #5A6069;
  font-size: 22rpx;
}

.modal-input,
.modal-picker {
  box-sizing: border-box;
  height: 70rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #1F2329;
  font-size: 26rpx;
  line-height: 70rpx;
}

.modal-row {
  display: flex;
  margin-top: 16rpx;
}

.modal-half {
  flex: 1;
}

.modal-half + .modal-half {
  margin-left: 16rpx;
}

.modal-add {
  width: 100%;
  height: 80rpx;
  margin-top: 28rpx;
  border-radius: 40rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 80rpx;
}

.modal-error {
  margin-top: 16rpx;
  color: #D9365F;
  font-size: 24rpx;
  text-align: center;
}

.modal-add::after {
  border: none;
}
