.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
}

.top {
  padding: 8rpx 4rpx 0;
}

.hello-title {
  color: #65020A;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hello-sub {
  margin-top: 8rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.type-scroll {
  height: 72rpx;
  margin-top: 24rpx;
  white-space: nowrap;
}

.type-tab {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 26rpx;
  border: 1rpx solid #F0DDE5;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5A6069;
  font-size: 24rpx;
}

.type-tab.active {
  border-color: #65020A;
  background: #65020A;
  color: #FFFFFF;
  font-weight: 500;
}

.conflict-tab.active {
  border-color: #0B6B57;
  background: #E6FBF5;
  color: #0B6B57;
  font-weight: 500;
}

.cache-banner {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #E6FBF5;
  color: #0B6B57;
  font-size: 22rpx;
}

.state {
  padding: 120rpx 40rpx;
  color: #8a9099;
  font-size: 26rpx;
  text-align: center;
}

.state-title {
  color: #4b5563;
  font-size: 32rpx;
  font-weight: 500;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 20rpx;
  border: 4rpx solid #FFE4F1;
  border-top-color: #65020A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.retry {
  display: inline-block;
  height: 72rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 72rpx;
}

.list {
  margin-top: 24rpx;
}

.card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-left: 6rpx solid #8A9099;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.card-academic {
  border-left-color: #7B8AD7;
  background: #FAFBFF;
}

.card-volunteer {
  border-left-color: #5ECD8C;
  background: #F7FDFA;
}

.card-sports {
  border-left-color: #B85516;
  background: #FFF9F4;
}

.card-skill {
  border-left-color: #615EDE;
  background: #FAF8FF;
}

.card-other {
  border-left-color: #F6CBC6;
  background: #FFF9F8;
}

.card-hover {
  background: #f7fbf9;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.card-meta {
  margin-top: 14rpx;
}

.meta-row {
  display: flex;
  margin-top: 6rpx;
  color: #646a73;
  font-size: 24rpx;
  line-height: 1.5;
}

.meta-label {
  flex: none;
  width: 64rpx;
  color: #9aa1aa;
}

.card-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef1f4;
  color: #4b5563;
  font-size: 20rpx;
}

.tag.academic {
  background: #ECEFFF;
  color: #4F5BA8;
}

.tag.volunteer {
  background: #E6FBF5;
  color: #0B6B57;
}

.tag.sports {
  background: #FFF0E6;
  color: #8A3F0F;
}

.tag.skill {
  background: #F0EAFF;
  color: #4A3BB5;
}

.tag.other {
  background: #FFF7F5;
  color: #6D483B;
}

.credit {
  margin-left: 16rpx;
  color: #8a9099;
  font-size: 22rpx;
}

.arrow {
  margin-left: 16rpx;
  color: #c4c9d0;
  font-size: 40rpx;
  line-height: 1;
}
