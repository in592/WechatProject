.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: #FFF8F6;
}

.hero {
  padding: 40rpx 32rpx 36rpx;
  background: #FFE4F1;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #FF7EC1;
  color: #65020A;
  font-size: 22rpx;
  font-weight: 500;
}

.tag.academic {
  background: #EEF0FF;
  color: #4F5BD5;
}

.tag.volunteer {
  background: #E6FBF5;
  color: #0B6B57;
}

.tag.sports {
  background: #FFF0E6;
  color: #B85516;
}

.tag.skill {
  background: #F0EAFF;
  color: #6B3FD4;
}

.tag.other {
  background: #F0EDEA;
  color: #5A6069;
}

.title {
  margin-top: 20rpx;
  color: #65020A;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
}

.time {
  margin-top: 16rpx;
  color: #65020A;
  font-size: 26rpx;
  opacity: 0.85;
}

.info-card {
  margin: 24rpx 32rpx 0;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.05);
}

.row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0DDE5;
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: none;
}

.label {
  flex: none;
  width: 120rpx;
  color: #8A9099;
}

.value {
  flex: 1;
  color: #1F2329;
  line-height: 1.5;
}

.notice {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.notice-title {
  color: #65020A;
  font-size: 24rpx;
  font-weight: 600;
}

.notice-text {
  margin-top: 12rpx;
  color: #5A6069;
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-all;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0DDE5;
  background: rgba(255, 248, 246, 0.97);
}

.signup {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.signup::after {
  border: none;
}

.state {
  padding: 160rpx 48rpx;
  color: #8A9099;
  font-size: 26rpx;
  text-align: center;
}

.state-title {
  color: #65020A;
  font-size: 32rpx;
  font-weight: 500;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 20rpx;
  border: 4rpx solid #FFE4F1;
  border-top-color: #65020A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.retry {
  display: inline-block;
  height: 72rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  background: #65020A;
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 72rpx;
}
