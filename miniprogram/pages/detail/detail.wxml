<view class="page">
  <view class="state" wx:if="{{loading}}">
    <view class="spinner"></view>
    <view>加载中…</view>
  </view>

  <view class="state" wx:elif="{{error}}">
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{error}}</view>
    <button class="retry" bindtap="onRetry">重试</button>
  </view>

  <block wx:elif="{{activity}}">
    <view class="hero">
      <text class="tag {{typeClass}}">{{typeText}}</text>
      <view class="title">{{activity.title}}</view>
      <view class="time">{{startText}}<text wx:if="{{endText}}"> - {{endText}}</text></view>
    </view>

    <view class="info-card">
      <view class="row">
        <text class="label">时间</text>
        <text class="value">{{startText}}<text wx:if="{{endText}}"> - {{endText}}</text></text>
      </view>
      <view class="row">
        <text class="label">地点</text>
        <text class="value">{{activity.location || '未标注'}}</text>
      </view>
      <view class="row">
        <text class="label">报名时间</text>
        <text class="value">{{signupText}}</text>
      </view>
      <view class="row">
        <text class="label">类型</text>
        <text class="value">{{typeText}}</text>
      </view>
      <view class="row">
        <text class="label">主办方</text>
        <text class="value">{{organizerText}}</text>
      </view>
    </view>

    <view class="notice" wx:if="{{activity.rawText}}">
      <view class="notice-title">原始通知</view>
      <view class="notice-text">{{activity.rawText}}</view>
    </view>

    <view class="action-bar">
      <view class="action-row" wx:if="{{signed}}">
        <view class="signed">已报名</view>
        <button class="cancel" bindtap="onCancelSignup">取消报名</button>
      </view>
      <button wx:else class="signup" bindtap="onSignup" loading="{{signing}}">报名</button>
    </view>
  </block>
</view>
